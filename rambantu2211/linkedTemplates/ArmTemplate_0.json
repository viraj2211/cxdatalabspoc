		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "source1_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "target1_csv",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Index as string,",
						"          {User Id} as string,",
						"          {First Name} as string,",
						"          {Last Name} as string,",
						"          Sex as string,",
						"          Email as string,",
						"          Phone as string,",
						"          {Date of birth} as string,",
						"          {Job Title} as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive({Date of birth} = toDate(trim(toString({Date of birth})), 'MM-dd-yyyy'),",
						"          Index = !isNull(trim(Index)) && trim(Index) != '') ~> derivedColumn1",
						"derivedColumn1 aggregate(groupBy({Job Title}),",
						"     {First Name} = first({First Name})) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/source1_csv')]",
				"[concat(variables('factoryId'), '/datasets/target1_csv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow3')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "emp_data_csv",
								"type": "DatasetReference"
							},
							"name": "empdatacsv"
						},
						{
							"dataset": {
								"referenceName": "deptdataparquet",
								"type": "DatasetReference"
							},
							"name": "deptdataparquet"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "target_emp_dept_csv",
								"type": "DatasetReference"
							},
							"name": "target"
						}
					],
					"transformations": [
						{
							"name": "cast1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "join1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          emp_id as string,",
						"          emp_name as string,",
						"          job_role as string,",
						"          salary as string,",
						"          dept_id as string,",
						"          hire_date as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> empdatacsv",
						"source(output(",
						"          dept_id as integer,",
						"          dept_name as string,",
						"          mgr_emp_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> deptdataparquet",
						"empdatacsv cast(output(",
						"          emp_id as integer,",
						"          salary as double,",
						"          dept_id as integer,",
						"          hire_date as date",
						"     ),",
						"     errors: true) ~> cast1",
						"cast1 derive(hire_date = iif(isNull(hire_date), toDate('1900-01-01','yyyy-MM-dd'), hire_date),",
						"          dept_id = iif(isNull(dept_id), 0, dept_id)) ~> derivedColumn1",
						"derivedColumn1, deptdataparquet join(derivedColumn1@dept_id == deptdataparquet@dept_id,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
