{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "emppoc_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "source2",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "cast1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as string,",
				"          emp_name as string,",
				"          job_role as string,",
				"          salary as string,",
				"          hire_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     fileList: true) ~> source1",
				"source(output(",
				"          emp_id as integer,",
				"          emp_name as string,",
				"          job_role as string,",
				"          salary as integer,",
				"          hire_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source2",
				"cast1, filter2 join(cast1@emp_id == source2@emp_id,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 cast(output(",
				"          emp_id as integer '000'",
				"     ),",
				"     errors: true) ~> cast1",
				"filter1 derive(job_role = iif(isNull(job_role) || trim(job_role) == '', 'Unknown', job_role)\r",
				") ~> derivedColumn1",
				"source1 filter(emp_id != 'emp_id' && !isNull(emp_id)\r",
				") ~> filter1",
				"source2 filter(source2.emp_id != 'emp_id' && !isNull(source2.emp_id)",
				") ~> filter2",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          description as string,",
				"          industry as string,",
				"          level as string,",
				"          size as string,",
				"          line_code as string,",
				"          value as string,",
				"          status as string,",
				"          Unit as string,",
				"          Footnotes as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}