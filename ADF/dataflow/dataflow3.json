{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "emp_data_csv",
						"type": "DatasetReference"
					},
					"name": "empdatacsv"
				},
				{
					"dataset": {
						"referenceName": "deptdataparquet",
						"type": "DatasetReference"
					},
					"name": "deptdataparquet"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "target_emp_dept_csv",
						"type": "DatasetReference"
					},
					"name": "target"
				}
			],
			"transformations": [
				{
					"name": "cast1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          emp_id as string,",
				"          emp_name as string,",
				"          job_role as string,",
				"          salary as string,",
				"          dept_id as string,",
				"          hire_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empdatacsv",
				"source(output(",
				"          dept_id as integer,",
				"          dept_name as string,",
				"          mgr_emp_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> deptdataparquet",
				"empdatacsv cast(output(",
				"          emp_id as integer,",
				"          salary as double,",
				"          dept_id as integer,",
				"          hire_date as date",
				"     ),",
				"     errors: true) ~> cast1",
				"cast1 derive(hire_date = iif(isNull(hire_date), toDate('1900-01-01','yyyy-MM-dd'), hire_date)\r",
				"\r",
				",",
				"          dept_id =  iif(isNull(dept_id), 0, dept_id)\r",
				") ~> derivedColumn1",
				"derivedColumn1, deptdataparquet join(derivedColumn1@dept_id == deptdataparquet@dept_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          description as string,",
				"          industry as string,",
				"          level as string,",
				"          size as string,",
				"          line_code as string,",
				"          value as string,",
				"          status as string,",
				"          Unit as string,",
				"          Footnotes as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> target"
			]
		}
	}
}